# Server Configuration
PORT=5000

# Supabase DB 1: Cognitive Aptitude Test
SUPABASE_URL_1=
SUPABASE_KEY_1=

# Supabase DB 2: Coding Skills Assessment
SUPABASE_URL_2=
SUPABASE_KEY_2=

# Supabase DB 3: Personality Profile
SUPABASE_URL_3=
SUPABASE_KEY_3=

# Supabase DB 4: English Proficiency Test
SUPABASE_URL_4=
SUPABASE_KEY_4=

# Supabase DB 5: Technical Architecture Quiz
SUPABASE_URL_5=
SUPABASE_KEY_5=

# GA4 Acquisition (Phase 7) — optional, only needed once GA4 is actually
# installed on a candidate-facing site. See backend/lib/ga4.js for setup
# steps. One service account key, shared across every tool's property.
GA4_SERVICE_ACCOUNT_KEY=
GA4_PROPERTY_ID_1=
GA4_PROPERTY_ID_2=
GA4_PROPERTY_ID_3=
GA4_PROPERTY_ID_4=
GA4_PROPERTY_ID_5=
GA4_PROPERTY_ID_6=

# Social module (Phase 1: YouTube + Google Business Profile) — see
# backend/migrations/001_social_schema.sql for the schema and
# backend/social/ for the adapters. A dedicated Supabase project, kept
# separate from db1-db6 since none of this is assessment data.
SUPABASE_URL_SOCIAL=
SUPABASE_KEY_SOCIAL=

# Public URLs used to build OAuth redirect URIs and the post-connect
# browser redirect back into the app.
BACKEND_PUBLIC_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5174

# One GCP OAuth 2.0 Client (Web application), shared by youtube.js and
# google-business.js — both are Google APIs under the same project.
# Add these redirect URIs to the client:
#   {BACKEND_PUBLIC_URL}/api/social/callback/youtube
#   {BACKEND_PUBLIC_URL}/api/social/callback/google_business
# Enable: YouTube Data API v3; My Business Account Management API,
# My Business Business Information API, My Business API (v4), and
# Business Profile Performance API.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Encrypts social_accounts.access_token/refresh_token at rest (AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SOCIAL_TOKEN_ENCRYPTION_KEY=
